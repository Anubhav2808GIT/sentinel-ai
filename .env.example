# SentinelAI — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# For production deployments, see docs/deployment.md.
#
#   cp .env.example .env

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Local Docker Compose defaults — do not use in production
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel_db
POSTGRES_HOST=postgres        # Docker service name (use managed host in prod)
POSTGRES_PORT=5432

# Alternative: provide a full DSN instead of individual fields
# DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@postgres:5432/sentinel_db

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis              # Docker service name (use managed host in prod)
REDIS_PORT=6379

# Alternative: full Redis URL (takes precedence when set)
# REDIS_URL=redis://redis:6379

# ── AI Analysis — Ollama ─────────────────────────────────────────────────────
# Set AI_DEMO_MODE=true to disable Ollama and use graceful fallback responses.
# All other platform features work normally without Ollama.
AI_DEMO_MODE=false
OLLAMA_BASE_URL=http://ollama:11434   # Docker service name
OLLAMA_MODEL=qwen2.5

# ── Frontend (Next.js public runtime config) ─────────────────────────────────
# These must be set at build time for Next.js.
# For local development, the defaults below match the Docker Compose port mappings.
NEXT_PUBLIC_WS_URL=ws://localhost:8003/ws
NEXT_PUBLIC_API_URL=http://localhost:8002

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# Defaults to allow-all (*) for local development.
# In production: CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=*

# ── Observability — Grafana ──────────────────────────────────────────────────
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false

# ── Runtime ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
