# ============================================================
# SentinelAI — Backend Production Environment Variables
# ============================================================
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to source control.
#
# Deployment target: Railway (https://railway.app) or Render (https://render.com)
# ============================================================

# ── PostgreSQL (use managed provider: Railway Postgres / Render Postgres / Neon) ──
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=<your-secure-password>
POSTGRES_DB=sentinel_db
POSTGRES_HOST=<your-postgres-host>       # e.g. monorail.proxy.rlwy.net (Railway)
POSTGRES_PORT=5432

# Or use a full DATABASE_URL if your provider gives one:
# DATABASE_URL=postgresql+asyncpg://sentinel:<password>@<host>:5432/sentinel_db

# ── Redis (use managed provider: Railway Redis / Render Redis / Upstash) ──────────
REDIS_HOST=<your-redis-host>             # e.g. containers-us-west-xxx.railway.app
REDIS_PORT=6379
# REDIS_URL=redis://<user>:<password>@<host>:<port>   # alternative full URL

# ── AI / Ollama ───────────────────────────────────────────────────────────────────
# OPTION A (Recommended): Disable Ollama in cloud — AI runs in Demo Mode
AI_DEMO_MODE=true
OLLAMA_BASE_URL=http://localhost:11434   # unused when AI_DEMO_MODE=true
OLLAMA_MODEL=qwen2.5

# OPTION B: Point to an external inference provider (e.g. Ollama on a GPU VM)
# AI_DEMO_MODE=false
# OLLAMA_BASE_URL=https://your-ollama-endpoint.example.com

# ── CORS Origins (comma-separated, include your Vercel frontend URL) ──────────────
CORS_ORIGINS=https://your-app.vercel.app,https://sentinel-ai.vercel.app

# ── Observability (Grafana — only relevant for Docker Compose local stack) ────────
GF_SECURITY_ADMIN_PASSWORD=<your-grafana-password>
GF_USERS_ALLOW_SIGN_UP=false

# ── Production Flags ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=production
# CLOUD_EVENT_RATE_MULTIPLIER=0.3   # throttle demo event generation in cloud (0.0–1.0)
